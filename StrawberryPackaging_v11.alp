					<Action><![CDATA[/*eventWriteValues.cancel();  // Stop the write event


// Simulate temperature fluctuation
varTemp = varTemp + uniform(-0.5, 0.5);

// Ensure temperature stays within the bounds of 0°C to 4°C
if (varTemp < 0) {
    varTemp = 0;  // Minimum temperature is 0°C
} else if (varTemp > 4) {
    varTemp = 4;  // Maximum temperature is 4°C
}

// Update room temperature 
roomTemperature = "Facility: Room Temperature: " + String.format("%.2f", varTemp) + " °C";  
textTemp.setText(roomTemperature);

// Adjust humidity based on temperature fluctuation (temperature influences the max humidity capacity)
double tempBasedHumidity = 90 + (4 - varTemp) * 1.25; 
// Higher temp lowers the max humidity range (90% to 95%)

varHumidity = varHumidity + uniform(-0.5, 0.5); // Simulate fluctuation

// Ensure humidity stays within the bounds for strawberries (90% to 95%) and based on temp
if (varHumidity < 90) {
    varHumidity = 90;  // Minimum humidity is 90%
} else if (varHumidity > tempBasedHumidity) {
    varHumidity = tempBasedHumidity;  // Maximum humidity dynamically changes with temperature
}

// Update room humidity display
roomHumidity = "Facility: Humidity: " + String.format("%.2f", varHumidity) + " %";
textHumidity.setText(roomHumidity);

// Compute fungus growth based on temperature and humidity
double fungusGrowth = 0;

// If temperature is between 0°C and 4°C (inclusive), set fungus growth to fixed value (less than 0.5%)
if (varTemp >= 0 && varTemp <= 4) {
    fungusGrowth = 0.3;  // Fixed fungus growth below 0.5% when temperature is between 0°C and 4°C
} else if (varTemp > 4) {
    // If temperature exceeds 4°C, calculate fungus growth
    double tempFactor = (varTemp - 4) * 0.2;  // Slower fungus growth increase

    // Cap fungus growth to 100% maximum
    fungusGrowth = Math.min(tempFactor * 100, 100); // Cap fungus growth at 100%
}

// Check if fungus growth is acceptable (below 0.5%)
if (fungusGrowth <= 0.5) {
    // Fungus growth is within acceptable limits (below 0.5%)
    roomFungusGrowth = "Fungus Growth: " + String.format("%.2f", fungusGrowth) + " % (Acceptable)";
} else if (fungusGrowth <= 50) {
    // Medium fungus growth warning
    roomFungusGrowth = "Fungus Growth: " + String.format("%.2f", fungusGrowth) + " % (Warning: Medium)";
} else {
    // High fungus growth warning
    roomFungusGrowth = "Fungus Growth: " + String.format("%.2f", fungusGrowth) + " % (Warning: High)";
}

// Update the fungus growth display
textFungusGrowth.setText(roomFungusGrowth);
  // Update the text element for fungus growth


// **Save data to CSV**
try {
    FileWriter fw = new FileWriter("temperature_humidity_data3.csv", true); // Append mode
    PrintWriter pw = new PrintWriter(fw);
    
    // Get current timestamp
    LocalDateTime now = LocalDateTime.now();
    String timestamp = now.format(DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss"));

    // Write data to CSV
    pw.println(timestamp + "," + varTemp + "," + varHumidity + "," + fungusGrowth);

    pw.flush();
    pw.close();
} catch (IOException e) {
    e.printStackTrace(); // Print error if file writing fails
}

*/
]]></Action>
