					<Body><![CDATA[
    String filePath = "temperature_humidity_data2.csv"; // Adjust path if needed
    try (BufferedReader br = new BufferedReader(new FileReader(filePath))) {
        String line;
        while ((line = br.readLine()) != null) {
            String[] values = line.split(","); // Split CSV by commas
            csvData.add(values);
        }
    } catch (IOException e) {
        e.printStackTrace();
    }

